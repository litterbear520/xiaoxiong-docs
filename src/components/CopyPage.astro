---
// 「复制页面」 split button, like Claude's docs. It copies the page's Markdown
// version (built by src/pages/[...slug].md.ts) so it can be pasted into Claude
// Code, Codex or a chat.
import { getCollection } from 'astro:content'

import { markdownPathFor } from '../lib/markdown'

const route = Astro.locals.starlightRoute
// Only pages from the docs collection have a .md twin; <StarlightPage> pages
// such as the 404 page don't.
const docIds = new Set((await getCollection('docs')).map((entry) => entry.id))
const hasMarkdown = docIds.has(route.id === '' ? 'index' : route.id)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const markdownHref = `${base}/${markdownPathFor(route.id)}`
const llmsHref = `${base}/llms.txt`
---

{
  hasMarkdown && (
    <xx-copy-page
      class="copy-page print:hidden"
      data-markdown={markdownHref}
      data-llms={llmsHref}
      data-pagefind-ignore="all"
    >
      <button type="button" class="copy-page-main" data-copy-page>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
        <span data-label>复制页面</span>
      </button>
      <details class="copy-page-more">
        <summary aria-label="更多复制选项">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="copy-page-menu">
          <a href={markdownHref} target="_blank" rel="noopener">
            <strong>查看 Markdown</strong>
            <span>在新标签页打开本页的纯文本版</span>
          </a>
          <button type="button" data-copy-llms>
            <strong>复制 llms.txt 地址</strong>
            <span>发给 AI，让它读完整份文档</span>
          </button>
        </div>
      </details>
    </xx-copy-page>
  )
}

<script>
  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text)
      return
    } catch {
      const area = document.createElement('textarea')
      area.value = text
      area.setAttribute('readonly', '')
      area.style.position = 'fixed'
      area.style.opacity = '0'
      document.body.append(area)
      area.select()
      const copied = document.execCommand('copy')
      area.remove()
      if (!copied) throw new Error('copy failed')
    }
  }

  class CopyPage extends HTMLElement {
    private markdown?: Promise<string>

    private load() {
      this.markdown ??= fetch(this.dataset.markdown ?? '').then((response) => {
        if (!response.ok) throw new Error(String(response.status))
        return response.text()
      })
      this.markdown.catch(() => (this.markdown = undefined))
      return this.markdown
    }

    // Safari only accepts a clipboard write that starts inside the click, so
    // the write is started right away with a ClipboardItem whose content is
    // still downloading. Browsers without that fall back to writeText.
    private copyPage(): Promise<void> {
      const text = this.load()
      if (typeof ClipboardItem !== 'undefined' && navigator.clipboard?.write) {
        const blob = text.then((value) => new Blob([value], { type: 'text/plain' }))
        return navigator.clipboard
          .write([new ClipboardItem({ 'text/plain': blob })])
          .catch(async () => copyText(await text))
      }
      return text.then(copyText)
    }

    connectedCallback() {
      const label = this.querySelector<HTMLElement>('[data-label]')
      const details = this.querySelector('details')
      const button = this.querySelector('[data-copy-page]')
      const flash = (text: string) => {
        if (!label) return
        label.textContent = text
        window.setTimeout(() => (label.textContent = '复制页面'), 1600)
      }

      for (const type of ['pointerenter', 'focus']) {
        button?.addEventListener(type, () => void this.load().catch(() => {}))
      }
      button?.addEventListener('click', () => {
        this.copyPage().then(
          () => flash('已复制'),
          () => flash('复制失败')
        )
      })

      this.querySelector('[data-copy-llms]')?.addEventListener('click', async () => {
        try {
          await copyText(new URL(this.dataset.llms ?? '', location.href).href)
          flash('已复制地址')
        } catch {
          flash('复制失败')
        }
        details?.removeAttribute('open')
      })

      document.addEventListener('click', (event) => {
        if (details?.open && !details.contains(event.target as Node)) details.removeAttribute('open')
      })
      this.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !details?.open) return
        details.removeAttribute('open')
        details.querySelector('summary')?.focus()
      })
    }
  }
  customElements.define('xx-copy-page', CopyPage)
</script>

<style>
  .copy-page {
    position: relative;
    display: flex;
    flex-shrink: 0;
    border: 1px solid var(--xx-hairline);
    border-radius: 0.5rem;
    background: var(--xx-surface);
    font-size: var(--sl-text-sm);
  }
  .copy-page-main,
  .copy-page-more summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    border: 0;
    border-radius: inherit;
    background: none;
    color: var(--sl-color-white);
    cursor: pointer;
    font: inherit;
  }
  .copy-page-main {
    border-start-end-radius: 0;
    border-end-end-radius: 0;
  }
  .copy-page-more summary {
    height: 100%;
    padding-inline: 0.5rem;
    border-inline-start: 1px solid var(--xx-hairline);
    border-start-start-radius: 0;
    border-end-start-radius: 0;
    list-style: none;
  }
  .copy-page-more summary::-webkit-details-marker {
    display: none;
  }
  .copy-page-main:hover,
  .copy-page-more summary:hover {
    background: var(--xx-hover);
  }
  .copy-page-main:focus-visible,
  .copy-page-more summary:focus-visible,
  .copy-page-menu :is(a, button):focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  .copy-page-menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.35rem);
    z-index: 20;
    display: grid;
    width: 15rem;
    padding: 0.3rem;
    border: 1px solid var(--xx-hairline);
    border-radius: 0.6rem;
    background: var(--xx-surface);
    box-shadow: var(--sl-shadow-md);
  }
  .copy-page-menu a,
  .copy-page-menu button {
    display: grid;
    gap: 0.1rem;
    padding: 0.45rem 0.6rem;
    border: 0;
    border-radius: 0.4rem;
    background: none;
    color: var(--sl-color-white);
    text-align: start;
    text-decoration: none;
    font: inherit;
    cursor: pointer;
  }
  .copy-page-menu a:hover,
  .copy-page-menu button:hover {
    background: var(--xx-hover);
  }
  .copy-page-menu strong {
    font-weight: 500;
  }
  .copy-page-menu span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  @media (max-width: 40rem) {
    .copy-page-menu {
      inset-inline-end: auto;
      inset-inline-start: 0;
    }
  }
</style>
