   * Dock. There is no milky core and no band of blur: the page shows through,
   * a little richer, and only the rim bends it (glass.ts). What sets it off is
   * a thin tint, a faint glow inside, white lines along the top and bottom that
   * fade towards the ends and dark lines at the ends. The dark values are
   * measured; the light theme gets a lighter tint with a faint outline and
   * shadow. It stays the same whatever passes under it, so the page shows through.
   */
  .xx-glass {
    --glass-radius: 20px;
    --glass-tint: rgb(246 248 251 / 0.16);
    --glass-side: 0.1;
    --glass-outline: 0.1;
    --glass-shadow: 0.2;
    position: absolute;
    top: 50%;
    left: 0;
    height: 2.5rem;
    border-radius: 999px;
    pointer-events: auto;
    transform: translate3d(0, -50%, 0);
    background-color: var(--glass-tint);
    box-shadow:
      inset 0 0 4px rgb(255 255 255 / 0.14),
      0 0 0 0.5px rgb(0 0 0 / var(--glass-outline)),
      0 4px 14px -6px rgb(0 0 0 / var(--glass-shadow));
    backdrop-filter: blur(1px) saturate(1.35);
    transition:
      background-color 0.28s,
      box-shadow 0.28s;
  }
  :root[data-theme='dark'] .xx-glass {
