    --glass-outline: 0;
    --glass-shadow: 0;
  }
  .xx-glass::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background:
      linear-gradient(
        90deg,
        rgb(0 0 0 / var(--glass-side)) 0,
        transparent 2px,
        transparent calc(100% - 2px),
        rgb(0 0 0 / var(--glass-side)) 100%
      ),
      linear-gradient(
        90deg,
        transparent calc(var(--glass-radius) * 0.25),
        rgb(255 255 255 / 0.24) var(--glass-radius),
        rgb(255 255 255 / 0.24) calc(100% - var(--glass-radius)),
        transparent calc(100% - var(--glass-radius) * 0.25)
      );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
