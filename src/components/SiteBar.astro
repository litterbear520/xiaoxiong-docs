---
// Replaces Starlight's header with the console's site bar (new-api
// web/src/components/site-bar), so going between the console and the docs
// feels like one site: the brand on the left and a pane of liquid glass on
// the right at the top of a page; scrolling down slides the brand in and
// stretches the glass over it into one pill in the middle of the screen.
// The words, the links and who is signed in come from what the console
// keeps in this browser (see src/lib/site-bar/state.ts), never from a
// session refresh, which the server rate-limits.
import Search from '@astrojs/starlight/components/Search.astro'

import { FLAGS, LABELS, LANGUAGES } from '../lib/site-bar/labels'
import { siteLinks } from '../lib/site-bar/state'

const zh = LABELS.zhCN
const links = siteLinks(null, zh)
const { hasSidebar } = Astro.locals.starlightRoute
const labels = LABELS
---

<div class="xx-bar" data-site-bar data-state="split">
  <div class="xx-glass" aria-hidden="true"></div>
  <span class="xx-seam" aria-hidden="true"></span>

  <div class="xx-brand">
    <a class="xx-brand-link" href="/">
      <img src="/brand/logo.png" alt="" width="24" height="24" />
      <span data-brand-name>小熊API</span>
    </a>
  </div>

  <div class="xx-dock">
    <nav class="xx-links" aria-label={zh['Site links']} data-la="Site links">
      <span class="xx-lens" aria-hidden="true" data-site-lens><span class="xx-magnifier"></span></span>
      {
        links.map((link, index) => (
          <a href={link.href} data-site-link draggable="false" aria-current={link.current ? 'page' : undefined} style={`--site-vt: site-link-${index}`}>
            {link.title}
          </a>
        ))
      }
    </nav>
    <span class="xx-divider xx-wide" aria-hidden="true"></span>

    <div class="xx-search"><Search /></div>

    <button type="button" data-theme-button aria-label={zh['Switch to dark theme']}></button>

    <button type="button" class="xx-icon" popovertarget="xx-language-menu" aria-label={zh['Change language']} data-la="Change language">
      <svg class="xx-i" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m5 8 6 6" /><path d="m4 14 6-6 2-3" /><path d="M2 5h12" /><path d="M7 2h1" /><path d="m22 22-5-10-5 10" /><path d="M14 18h6" />
      </svg>
    </button>
    <div id="xx-language-menu" popover class="xx-menu" role="menu">
      {
        LANGUAGES.map((language) => (
          <button type="button" role="menuitemradio" data-language={language.code}>
            {FLAGS[language.code] ? (
              <span class="xx-flag" set:html={FLAGS[language.code]} />
            ) : (
              <span class="xx-flag xx-flag-text">繁</span>
            )}
            <span>{language.label}</span>
            <svg class="xx-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          </button>
        ))
      }
    </div>

    <button type="button" class="xx-icon xx-signed-in" popovertarget="xx-notifications" aria-label={zh.Notifications} data-la="Notifications">
      <svg class="xx-i" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M10.268 21a2 2 0 0 0 3.464 0" />
        <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" />
      </svg>
      <span class="xx-badge" data-badge hidden></span>
    </button>
    <div id="xx-notifications" popover class="xx-menu xx-panel">
      <p class="xx-panel-title" data-l="Notifications">{zh.Notifications}</p>
      <p class="xx-panel-lead" data-l="Latest platform updates and notices">{zh['Latest platform updates and notices']}</p>
      <div data-notifications></div>
    </div>

    <button type="button" class="xx-avatar xx-signed-in" data-bar-skip popovertarget="xx-account-menu" aria-label={zh['Account menu']} data-la="Account menu">
      <span data-avatar></span>
    </button>
    <div id="xx-account-menu" popover class="xx-menu" role="menu">
      <div class="xx-account-head">
        <p data-account-name></p>
        <p data-account-detail></p>
      </div>
      <hr />
      <a role="menuitem" href="/profile" data-l="Account settings">{zh['Account settings']}</a>
      <a role="menuitem" href="/system-settings/site/system-info" data-l="System Settings" data-super-admin hidden>{zh['System Settings']}</a>
      <a role="menuitem" href="/dashboard" data-l="Console">{zh.Console}</a>
    </div>

    <a class="xx-sign-in xx-signed-out" href="/sign-in" data-l="Sign in">{zh['Sign in']}</a>

    {
      hasSidebar && (
        <button type="button" class="xx-icon xx-narrow" popovertarget="starlight__sidebar" aria-label={zh['Toggle navigation menu']} data-la="Toggle navigation menu">
          <span class="xx-menu-icon" aria-hidden="true"><span /><span /><span /></span>
        </button>
      )
    }
  </div>
</div>

{/* Before the first paint: the reader's language and who is signed in, so the
    bar never flashes the wrong words or 登录 for a signed-in reader. The rules
    are the tested ones in src/lib/site-bar/state.ts, kept short here. */}
<script is:inline define:vars={{ labels }}>
  ;(() => {
    const bar = document.querySelector('[data-site-bar]')
    if (!bar) return
    let saved = null
    let note = null
    try {
      saved = localStorage.getItem('i18nextLng')
      note = JSON.parse(localStorage.getItem('newapi:site-bar:v1:account') || 'null')
    } catch {}
    const tag = (saved || navigator.language || '').replace('_', '-').toLowerCase()
    let lang = labels[saved] ? saved : null
    if (!lang && tag.startsWith('zh')) lang = /^zh-?(tw|hk|mo|hant)/.test(tag) ? 'zhTW' : 'zhCN'
    if (!lang) lang = labels[tag.split('-')[0]] ? tag.split('-')[0] : 'en'
    const words = labels[lang]
    bar.dataset.language = lang
    for (const el of bar.querySelectorAll('[data-l]')) el.textContent = words[el.dataset.l] || el.textContent
    for (const el of bar.querySelectorAll('[data-la]')) el.setAttribute('aria-label', words[el.dataset.la] || '')
    const links = bar.querySelectorAll('[data-site-link]')
    const titles = [words.Home, words.Console, words['Model Square'], words.Offers, words.Docs]
    if (links.length === titles.length) links.forEach((a, i) => (a.textContent = titles[i]))
    // The page this one was opened from left its bar together: draw it so
    // for the first frame (the cross-fade starts from it), then the module
    // script opens it. Same sums as paint() below.
    // The lens too, where the page before left it mid-slide, so the first
    // frame has it there; the module script carries the slide on. (Before
    // anything below reads the layout: set later, its opacity would fade.)
    try {
      const note = document.prerendering ? null : JSON.parse(sessionStorage.getItem('newapi:site-bar:v1:lens') || 'null')
      const age = note ? Date.now() - note.at : NaN
      if (note && document.referrer && note.from === document.referrer && age >= 0 && age <= 3000) {
        const lens = bar.querySelector('.xx-lens')
        lens.style.transform = `translate3d(${note.left}px,0,0)`
        lens.style.width = `${note.right - note.left}px`
        lens.style.opacity = '1'
      }
    } catch {}
    // Drawn ahead of the click (speculation rules), the notes aren't written
    // yet: the module script reads them when the page is shown.
    let start = 0
    try {
      const handoff = document.prerendering ? null : JSON.parse(sessionStorage.getItem('newapi:site-bar:v1:handoff') || 'null')
      if (handoff && document.referrer && handoff.from === document.referrer) start = Math.min(1, Math.max(0, +handoff.q || 0))
    } catch {}
    window.__xxReveal = new Promise((resolve) =>
      addEventListener('pagereveal', (event) => resolve(event.viewTransition ? event.viewTransition.finished : null), { once: true })
    )
    if (start > 0) {
      const brand = bar.querySelector('.xx-brand')
      const dock = bar.querySelector('.xx-dock')
      const glass = bar.querySelector('.xx-glass')
      const seam = bar.querySelector('.xx-seam')
      const pillWidth = 14 + brand.offsetWidth + 9 + dock.offsetWidth
      const pillLeft = Math.round((bar.clientWidth - pillWidth) / 2)
      const brandX = (pillLeft + 14 - brand.offsetLeft) * start
      const lerp = (a, b) => a + (b - a) * start
      brand.style.transform = `translate3d(${brandX}px,0,0)`
      dock.style.transform = `translate3d(${(pillLeft + 14 + brand.offsetWidth + 9 - dock.offsetLeft) * start}px,0,0)`
      const left = lerp(dock.offsetLeft, pillLeft)
      glass.style.transform = `translate3d(${left}px,-50%,0)`
      glass.style.width = `${lerp(dock.offsetLeft + dock.offsetWidth, pillLeft + pillWidth) - left}px`
      seam.style.transform = `translate3d(${brand.offsetLeft + brand.offsetWidth + brandX + 4.5}px,-50%,0)`
      seam.style.opacity = String(Math.min(1, Math.max(0, (start - 0.6) / 0.4)))
      bar.dataset.state = start >= 1 ? 'assembled' : 'moving'
    }
    const hint = /(?:^|;\s*)new_api_has_session=/.test(document.cookie)
    if (hint && note && typeof note.name === 'string' && note.avatar) {
      bar.dataset.signedIn = ''
      const avatar = bar.querySelector('[data-avatar]')
      avatar.textContent = note.avatar.text
      avatar.style.backgroundColor = note.avatar.background
    }
  })()
</script>
{/* The first paint waits for this (astro.config.ts): the bar is whole by now. */}
<span id="xx-bar-ready" hidden></span>

<script>
  import { mountGlass } from '../lib/site-bar/glass'
  import { LABELS, type LanguageCode } from '../lib/site-bar/labels'
  import { Lens, SWOLLEN, lensAt, nearestLink } from '../lib/site-bar/lens'
  import { DOCS_BASE } from '../site'
  import { ThemeSwitch, type ThemeSwitchState } from '../lib/site-bar/theme-switch'
  import { BarMorph } from '../lib/site-bar/morph'
  import {
    ACCOUNT_NOTE_KEY,
    accountFromNote,
    announcementKey,
    announcements,
    HANDOFF_KEY,
    handoffStart,
    interfaceLanguage,
    LANGUAGE_KEY,
    LENS_HANDOFF_KEY,
    lensNote,
    READ_MARKS_KEY,
    SESSION_HINT_COOKIE,
    siteLinks,
    STATUS_KEY,
    storedTheme,
    THEME_KEY,
    unreadCount,
    type Arrival,
    type ReadMarks,
    type Theme,
  } from '../lib/site-bar/state'

  /** As in the console: the brand's inset in the pill, and room for the hairline. */
  const BRAND_INSET = 14
  const SEAM = 9

  const read = (key: string) => {
    try {
      return localStorage.getItem(key)
    } catch {
      return null
    }
  }
  const readJson = <T,>(key: string): T | null => {
    try {
      return JSON.parse(read(key) ?? 'null') as T | null
    } catch {
      return null
    }
  }

  const bar = document.querySelector<HTMLElement>('[data-site-bar]')!
  const glass = bar.querySelector<HTMLElement>('.xx-glass')!
  const brand = bar.querySelector<HTMLElement>('.xx-brand')!
  const dock = bar.querySelector<HTMLElement>('.xx-dock')!
  const seam = bar.querySelector<HTMLElement>('.xx-seam')!
  const nav = bar.querySelector<HTMLElement>('.xx-links')!
  const lensEl = bar.querySelector<HTMLElement>('.xx-lens')!
  const status = readJson<Record<string, unknown>>(STATUS_KEY)

  // The style read comes first: a transition starts from the last style the
  // browser computed, and that must be the one with the stylesheet in it.
  void getComputedStyle(bar).color
  bar.dataset.ready = ''

  // --- words and links, in the reader's language and the admin's switches
  function applyLanguage(language: LanguageCode) {
    const words = LABELS[language]
    bar.dataset.language = language
    for (const el of bar.querySelectorAll<HTMLElement>('[data-l]')) {
      el.textContent = words[el.dataset.l as keyof typeof words] ?? el.textContent
    }
    for (const el of bar.querySelectorAll<HTMLElement>('[data-la]')) {
      el.setAttribute('aria-label', words[el.dataset.la as keyof typeof words] ?? '')
    }
    nav.replaceChildren(
      lensEl,
      ...siteLinks(status, words).map((link, index) => {
        const a = document.createElement('a')
        a.href = link.href
        a.dataset.siteLink = ''
        a.draggable = false
        if (link.current) a.setAttribute('aria-current', 'page')
        a.style.setProperty('--site-vt', `site-link-${index}`)
        a.textContent = link.title
        return a
      })
    )
    for (const item of bar.querySelectorAll<HTMLElement>('[data-language]')) {
      item.setAttribute('aria-checked', String(item.dataset.language === language))
    }
    // the same links in the sidebar, for narrow screens (Sidebar.astro)
    const sidebarLinks = document.querySelector<HTMLElement>('[data-sidebar-site-links]')
    const template = sidebarLinks?.querySelector('a')
    if (sidebarLinks && template) {
      sidebarLinks.setAttribute('aria-label', words['Site links'])
      sidebarLinks.replaceChildren(
        ...siteLinks(status, words)
          .filter((link) => !link.current)
          .map((link) => {
            const a = template.cloneNode(true) as HTMLAnchorElement
            a.href = link.href
            a.firstChild!.textContent = link.title
            return a
          })
      )
    }
    updateThemeLabel()
  }

  // --- the lens under 文档, or under the link clicked to leave for
  const litLink = () =>
    nav.querySelector<HTMLElement>('[data-lit]') ?? nav.querySelector<HTMLElement>('[aria-current="page"]')

  // --- the morph, as in the console (window scroll only: the docs scroll the page)
  let geometry: {
    brandTravel: number
    dockTravel: number
    brandRight: number
    splitLeft: number
    splitRight: number
    pillLeft: number
    pillRight: number
  } | null = null
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t
  function measure() {
    const pillWidth = BRAND_INSET + brand.offsetWidth + SEAM + dock.offsetWidth
    const pillLeft = Math.round((bar.clientWidth - pillWidth) / 2)
    geometry = {
      brandTravel: pillLeft + BRAND_INSET - brand.offsetLeft,
      dockTravel: pillLeft + BRAND_INSET + brand.offsetWidth + SEAM - dock.offsetLeft,
      brandRight: brand.offsetLeft + brand.offsetWidth,
      splitLeft: dock.offsetLeft,
      splitRight: dock.offsetLeft + dock.offsetWidth,
      pillLeft,
      pillRight: pillLeft + pillWidth,
    }
  }
  function paint(q: number) {
    let state = 'moving'
    if (q <= 0) state = 'split'
    if (q >= 1) state = 'assembled'
    bar.dataset.state = state
    if (!geometry) return
    const g = geometry
    const brandX = g.brandTravel * q
    brand.style.transform = `translate3d(${brandX}px,0,0)`
    dock.style.transform = `translate3d(${g.dockTravel * q}px,0,0)`
    const left = lerp(g.splitLeft, g.pillLeft, q)
    const right = lerp(g.splitRight, g.pillRight, q)
    glass.style.transform = `translate3d(${left}px,-50%,0)`
    glass.style.width = `${right - left}px`
    seam.style.transform = `translate3d(${g.brandRight + brandX + SEAM / 2}px,-50%,0)`
    seam.style.opacity = String(Math.min(1, Math.max(0, (q - 0.6) / 0.4)))
  }
  const still = matchMedia('(prefers-reduced-motion: reduce)')
  const lens = new Lens(lensEl, () => still.matches, lensEl.querySelector<HTMLElement>('.xx-magnifier'))
  // built in arrive(), once the page is shown
  let morph: BarMorph | null = null
  const together = () => morph?.value ?? 0

  /**
   * The page is on screen (at once, or on the click for one the browser drew
   * ahead): take what the page before left, the bar's state and the lens's
   * slide, and carry them on.
   */
  function arrive(arrival: Arrival, revealed: Promise<Promise<unknown> | null> | undefined) {
    let handoff: string | null = null
    let lensRaw: string | null = null
    try {
      handoff = sessionStorage.getItem(HANDOFF_KEY)
      lensRaw = sessionStorage.getItem(LENS_HANDOFF_KEY)
      sessionStorage.removeItem(HANDOFF_KEY)
      sessionStorage.removeItem(LENS_HANDOFF_KEY)
    } catch {
      // storage blocked: start split, the lens in place
    }
    morph = new BarMorph({
      pinned: false,
      top: window.scrollY,
      start: handoffStart(handoff, document.referrer, arrival),
      onChange: paint,
      reducedMotion: () => still.matches,
    })
    measure()
    paint(morph.value)
    lens.slide(litLink(), lensNote(lensRaw, document.referrer, arrival))
    // Arrived with the bar together: open it once the cross-fade is over (or
    // at once where there is none).
    const opened = morph
    void Promise.race([revealed?.then((finished) => finished), new Promise((r) => setTimeout(r, 600))])
      .catch(() => {})
      .then(() => requestAnimationFrame(() => opened.follow(false, window.scrollY)))
  }

  // Leaving for a whole new page: note the bar's state and where the lens
  // is, for that page's bar (the console's, or the docs' again).
  function leave() {
    // as the next page's referrer names this one: without its #part
    const from = location.href.split('#')[0]
    try {
      sessionStorage.setItem(HANDOFF_KEY, JSON.stringify({ q: together(), from, at: Date.now() }))
      const note = nav.offsetWidth > 0 ? lens.note() : null
      if (note) sessionStorage.setItem(LENS_HANDOFF_KEY, JSON.stringify({ ...note, from, at: Date.now() }))
    } catch {
      // storage blocked: the next page starts split
    }
  }
  addEventListener('pageswap', leave)
  addEventListener('pagehide', leave)

  // A plain click on a site link lights it at once: the lens slides there
  // while the next page loads, and that page's bar carries the slide on.
  // The console's pages show nothing while their app starts (~250 ms, the
  // old page held still on screen): the lens would stop mid-way, so it lands
  // here first, then the page goes.
  const LAND_MS = 280
  // only the last click goes: a second one while the lens lands wins
  let clicks = 0
  nav.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-site-link]')
    if (!link || link === litLink() || event.defaultPrevented || event.button !== 0) return
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
    const click = ++clicks
    for (const other of nav.querySelectorAll('[data-lit]')) other.removeAttribute('data-lit')
    link.dataset.lit = ''
    lens.slide(link)
    if (link.pathname.startsWith(`${DOCS_BASE}/`)) return
    event.preventDefault()
    void lens.landed(LAND_MS).then(() => {
      if (click === clicks) location.assign(link.href)
    })
  })
  // Back here out of the back/forward cache: light this page again.
  addEventListener('pageshow', (event) => {
    if (!event.persisted || !nav.querySelector('[data-lit]')) return
    for (const other of nav.querySelectorAll('[data-lit]')) other.removeAttribute('data-lit')
    lens.slide(litLink())
  })

  // Press, drag sideways, let go, as in the console (site-nav-links.tsx
  // useLensDrag): the lens follows the finger, swollen, and letting go clicks
  // the link under it, so it opens exactly as a click would (above). A press
  // that does not move is a plain click; Escape, or the browser taking the
  // gesture over (a scroll), puts the lens back.
  const DRAG_SLOP = 6
  // the least gap, in px, between a dragged lens and the end of the glass
  const GLASS_MARGIN = 1
  // the bar's glass, in px from the links' left: the lens stays inside it
  const glassBounds = (navLeft: number) => {
    const glass = bar.querySelector('.xx-glass')!.getBoundingClientRect()
    return { left: glass.left - navLeft + GLASS_MARGIN, right: glass.right - navLeft - GLASS_MARGIN }
  }
  // the links' places in the row are measured once the drag starts: they stay put while it lasts
  let press: {
    pointerId: number
    x: number
    y: number
    dragging: boolean
    aimed: number
    spans: { left: number; right: number }[]
    // the lens's middle less the finger's, kept when the press was on the lens
    grip: number
  } | null = null
  // the browser's own click after a drag is not a click on a link
  let swallowClick = false
  const siteLinkEls = () => [...nav.querySelectorAll<HTMLAnchorElement>('a[data-site-link]')]
  const spans = () => siteLinkEls().map((a) => ({ left: a.offsetLeft, right: a.offsetLeft + a.offsetWidth }))
  function aim(index: number | null) {
    siteLinkEls().forEach((a, i) => a.toggleAttribute('data-aimed', i === index))
  }
  function letGo(pick: boolean, stillDown = false) {
    const p = press
    press = null
    if (!p?.dragging) return
    swallowClick = true
    const clear = () => setTimeout(() => (swallowClick = false), 0)
    // Escape comes before the release, and the release's click is the one to swallow
    if (stillDown) addEventListener('pointerup', clear, { once: true })
    else clear()
    if (nav.hasPointerCapture(p.pointerId)) nav.releasePointerCapture(p.pointerId)
    delete nav.dataset.dragging
    removeEventListener('keydown', onEscape)
    aim(null)
    lens.release()
    lens.swellTo(false)
    const link = siteLinkEls()[p.aimed]
    if (pick && link && link !== litLink()) link.click()
    else lens.slide(litLink())
  }
  function onEscape(event: KeyboardEvent) {
    if (event.key === 'Escape') letGo(false, true)
  }
  nav.addEventListener('pointerdown', (event) => {
    if (!event.isPrimary || (event.pointerType === 'mouse' && event.button !== 0)) return
    swallowClick = false
    press = { pointerId: event.pointerId, x: event.clientX, y: event.clientY, dragging: false, aimed: -1, spans: [], grip: 0 }
  })
  nav.addEventListener('pointermove', (event) => {
    const p = press
    if (!p || event.pointerId !== p.pointerId) return
    // a mouse let go outside the links, where its release went unseen
    if (event.pointerType === 'mouse' && (event.buttons & 1) === 0) {
      letGo(false)
      return
    }
    if (!p.dragging) {
      if (Math.abs(event.clientX - p.x) < DRAG_SLOP) {
        // mostly up or down: not ours
        if (Math.abs(event.clientY - p.y) > DRAG_SLOP * 2) press = null
        return
      }
      p.dragging = true
      p.spans = spans()
      const navLeft = nav.getBoundingClientRect().left
      const pressedAt = p.x - navLeft
      const at = lens.span()
      const onLens = at !== null && pressedAt >= at.left && pressedAt <= at.right
      p.grip = onLens ? (at.left + at.right) / 2 - pressedAt : 0
      lens.hold(glassBounds(navLeft), !onLens)
      nav.setPointerCapture(event.pointerId)
      nav.dataset.dragging = ''
      addEventListener('keydown', onEscape)
      // the words again, for the lens to magnify (the links may have changed language)
      lensEl
        .querySelector('.xx-magnifier')
        ?.replaceChildren(...siteLinkEls().map((a) => Object.assign(document.createElement('span'), { textContent: a.textContent })))
      lens.swellTo(true)
    }
    if (!p.spans.length) return
    // read each time: a scroll can move the bar under a still-held finger
    const navLeft = nav.getBoundingClientRect().left
    const bounds = glassBounds(navLeft)
    lens.setBounds(bounds)
    const to = lensAt(p.spans, event.clientX - navLeft + p.grip, bounds, still.matches ? 1 : SWOLLEN)
    lens.follow(to)
    const index = nearestLink(p.spans, (to.left + to.right) / 2)
    if (index !== p.aimed) {
      p.aimed = index
      aim(index)
    }
  })
  // a quick flick can leave the links before it has counted as a drag
  nav.addEventListener('pointerleave', (event) => {
    if (press && !press.dragging && event.pointerId === press.pointerId) nav.setPointerCapture(event.pointerId)
  })
  nav.addEventListener('pointerup', (event) => {
    if (event.pointerId === press?.pointerId) letGo(true)
  })
  nav.addEventListener('pointercancel', (event) => {
    if (event.pointerId === press?.pointerId) letGo(false)
  })
  nav.addEventListener(
    'click',
    (event) => {
      if (swallowClick && event.isTrusted) {
        event.preventDefault()
        event.stopImmediatePropagation()
      }
    },
    { capture: true }
  )

  let lastTop = window.scrollY
  addEventListener(
    'scroll',
    () => {
      const top = window.scrollY
      morph?.scroll(lastTop, top)
      lastTop = top
    },
    { passive: true }
  )
  new ResizeObserver(() => {
    measure()
    paint(together())
    lens.place(litLink())
  }).observe(dock)
  new ResizeObserver(() => {
    measure()
    paint(together())
  }).observe(bar)
  mountGlass(glass)

  // --- theme: the console's setting, flipped like the console's button
  const currentTheme = (): Theme => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark')
  const themeButton = bar.querySelector<HTMLButtonElement>('[data-theme-button]')!
  const themeSwitchState = (): ThemeSwitchState => {
    const words = LABELS[(bar.dataset.language as LanguageCode) ?? 'zhCN']
    return {
      look: currentTheme(),
      pinned: false,
      nightFound: false,
      labels: {
        light: words['Switch to light theme'],
        dark: words['Switch to dark theme'],
        night: words['Switch to dark theme'],
      },
    }
  }
  const themeSwitch = new ThemeSwitch(themeButton, {
    ...themeSwitchState(),
    onLook: (look) => {
      const theme: Theme = look === 'light' ? 'light' : 'dark'
      try {
        localStorage.setItem(THEME_KEY, theme)
      } catch {
        // storage blocked: the switch still works for this page
      }
      document.documentElement.dataset.theme = theme
    },
  })
  function updateThemeLabel() {
    themeSwitch.update(themeSwitchState())
  }
  function applyTheme(theme: Theme) {
    document.documentElement.dataset.theme = theme
    updateThemeLabel()
  }
  // ThemeProvider set the theme before the first paint; the tested rule has the last word.
  const chosen = storedTheme(read(THEME_KEY), null)
  if (chosen && chosen !== currentTheme()) applyTheme(chosen)
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
    const saved = read(THEME_KEY)
    if (saved !== 'light' && saved !== 'dark') applyTheme(event.matches ? 'light' : 'dark')
  })

  // --- language: the console's setting; the docs' own pages stay in Chinese
  for (const item of bar.querySelectorAll<HTMLButtonElement>('[data-language]')) {
    item.addEventListener('click', () => {
      const language = item.dataset.language as LanguageCode
      try {
        localStorage.setItem(LANGUAGE_KEY, language)
      } catch {
        // storage blocked: this page still switches
      }
      applyLanguage(language)
      bar.querySelector<HTMLElement>('#xx-language-menu')?.hidePopover()
    })
  }

  // --- menus open under their button, like the console's
  for (const menu of bar.querySelectorAll<HTMLElement>('.xx-menu')) {
    menu.addEventListener('beforetoggle', (event) => {
      if ((event as ToggleEvent).newState !== 'open') return
      const button = bar.querySelector<HTMLElement>(`[popovertarget="${menu.id}"]`)
      if (!button) return
      const box = button.getBoundingClientRect()
      menu.style.top = `${box.bottom + 10}px`
      menu.style.right = `${Math.max(8, innerWidth - box.right - 4)}px`
    })
  }

  // --- the account: the console's note, while the server's session hint says so
  const hasHint = new RegExp(`(?:^|;\\s*)${SESSION_HINT_COOKIE}=`).test(document.cookie)
  const account = accountFromNote(hasHint, read(ACCOUNT_NOTE_KEY))
  if (account) {
    bar.dataset.signedIn = ''
    const avatar = bar.querySelector<HTMLElement>('[data-avatar]')!
    avatar.textContent = account.avatar.text
    avatar.style.backgroundColor = account.avatar.background
    bar.querySelector('[data-account-name]')!.textContent = account.name
    bar.querySelector('[data-account-detail]')!.textContent = account.detail
    bar.querySelector<HTMLElement>('[data-super-admin]')!.hidden = !account.superAdmin
  } else {
    delete bar.dataset.signedIn
  }

  // --- the bell: the console's announcements (cached status) and notice
  const NOTICE_CACHE = 'xx-site-bar-notice'
  async function loadNotice(): Promise<string> {
    try {
      const cached = JSON.parse(sessionStorage.getItem(NOTICE_CACHE) ?? 'null') as { at: number; text: string } | null
      if (cached && Date.now() - cached.at < 5 * 60_000) return cached.text
    } catch {
      // no cache
    }
    try {
      const response = await fetch('/api/notice', { credentials: 'same-origin' })
      const body = (await response.json()) as { success?: boolean; data?: string }
      const text = body.success ? (body.data ?? '').trim() : ''
      sessionStorage.setItem(NOTICE_CACHE, JSON.stringify({ at: Date.now(), text }))
      return text
    } catch {
      return ''
    }
  }
  const readMarks = () => readJson<{ state?: ReadMarks }>(READ_MARKS_KEY)?.state ?? null
  function showCount(notice: string) {
    const count = unreadCount(status, readMarks(), notice)
    const badge = bar.querySelector<HTMLElement>('[data-badge]')!
    badge.hidden = count === 0
    badge.textContent = count > 9 ? '9+' : String(count)
  }
  const panel = bar.querySelector<HTMLElement>('#xx-notifications')!
  let notice = ''
  function renderPanel() {
    const words = LABELS[(bar.dataset.language as LanguageCode) ?? 'zhCN']
    const list = panel.querySelector<HTMLElement>('[data-notifications]')!
    const items = announcements(status)
    list.replaceChildren()
    if (notice) {
      const block = document.createElement('section')
      block.className = 'xx-notice'
      const title = document.createElement('p')
      title.className = 'xx-notice-title'
      title.textContent = words.Notice
      const text = document.createElement('p')
      text.textContent = notice.replace(/<[^>]+>/g, '')
      block.append(title, text)
      list.append(block)
    }
    for (const item of items) {
      const row = document.createElement('article')
      row.className = 'xx-announcement'
      const text = document.createElement('p')
      text.textContent = String(item.content ?? '').replace(/<[^>]+>/g, '')
      const date = document.createElement('time')
      date.textContent = String(item.publishDate ?? '').slice(0, 10)
      row.append(text, date)
      list.append(row)
    }
    if (!notice && items.length === 0) {
      const empty = document.createElement('p')
      empty.className = 'xx-empty'
      empty.textContent = words['No announcements at this time']
      list.append(empty)
    }
    // read, as opening the console's bell marks them
    const stored = readJson<{ state?: Record<string, unknown>; version?: number }>(READ_MARKS_KEY) ?? {}
    const state = { closedUntilDate: null, ...stored.state } as Record<string, unknown>
    const keys = new Set([...((state.readAnnouncementKeys as string[]) ?? []), ...items.map(announcementKey)])
    state.readAnnouncementKeys = [...keys]
    if (notice) state.lastReadNotice = notice
    try {
      localStorage.setItem(READ_MARKS_KEY, JSON.stringify({ state, version: stored.version ?? 0 }))
    } catch {
      // storage blocked: the count comes back on the next page
    }
    showCount(notice)
  }
  if (account) {
    showCount(notice)
    panel.addEventListener('toggle', (event) => {
      if ((event as ToggleEvent).newState === 'open') renderPanel()
    })
    // the notice arrives a moment later; an open panel takes it in
    void loadNotice().then((text) => {
      notice = text
      if (panel.matches(':popover-open')) renderPanel()
      else showCount(notice)
    })
  }

  applyLanguage(interfaceLanguage(read(LANGUAGE_KEY), navigator.language))
  measure()
  paint(together())
  lens.place(litLink())
  const revealed = (window as unknown as { __xxReveal?: Promise<Promise<unknown> | null> }).__xxReveal
  // (not yet in TypeScript's DOM types)
  if ((document as Document & { prerendering?: boolean }).prerendering) {
    // Shown on the click: its own reveal (any during the drawing is over)
    document.addEventListener(
      'prerenderingchange',
      () => {
        const shown = new Promise<Promise<unknown> | null>((resolve) =>
          addEventListener('pagereveal', (event) => resolve(event.viewTransition ? event.viewTransition.finished : null), { once: true })
        )
        arrive({ prerendered: true, now: Date.now() }, shown)
      },
      { once: true }
    )
  } else {
    arrive({ prerendered: false, now: Date.now() }, revealed)
  }
</script>

<style is:global>
